# apex_desk/.env  (copy from .env.example; NEVER commit .env)
# Separate demo account for the desk (the old scheduler keeps its own account in the repo-root .env).
DESK_MT5_LOGIN=
DESK_MT5_PASSWORD=
DESK_MT5_SERVER=
# Full path to the terminal64.exe of the terminal logged in to the DESK account (two terminals can run side by side)
DESK_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5 DESK\terminal64.exe
# Optional: Telegram alerts (same variables the old system uses)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Needed only if the desk should refresh stale data itself (normally it reads the old scheduler's cache)
TWELVEDATA_API_KEY=
# Cloud relay (Supabase -> Settings -> API). SERVICE key is secret: Work PC only, never in the website
DESK_SUPABASE_URL=
DESK_SUPABASE_SERVICE_KEY=
