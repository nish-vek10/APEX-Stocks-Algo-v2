# ─── IG Group API Credentials ─────────────────────────────────────────────────
IG_IDENTIFIER=your_ig_username
IG_PASSWORD=your_ig_password
IG_API_KEY=your_ig_api_key
IG_ACCOUNT_ID=your_ig_account_id
IG_ACC_TYPE=DEMO           # DEMO | LIVE

# ─── MT5 Credentials (legacy — only needed if broker=mt5) ─────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=mt5_password_
MT5_SERVER=Broker-Server
MT5_TERMINAL_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# ─── Alerting (optional) ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=telegram_bot_token
TELEGRAM_CHAT_ID=chat_id
ALERT_EMAIL=johndoe@email.com
SMTP_PASSWORD=smtp_password
